{
  "name": "teamwork-mcp-server",
  "version": "3.0.0",
  "private": true,
  "type": "module",
  "description": "Project- and user-agnostic MCP server for Teamwork.com: projects, tasks, board lanes, comments, attachments and time tracking for any MCP client",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "check": "node --check src/*.js test/*.js",
    "test": "node --test test/unit.test.js test/live.test.js",
    "test:unit": "node --test test/unit.test.js",
    "test:live": "node --test test/live.test.js",
    "task:move-stage": "node src/task-stage.js",
    "debug": "LOG_LEVEL=debug node src/server.js"
  },
  "repository": {
    "type": "git",
    "url": "git@github.com:corcronje/teamwork-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/corcronje/teamwork-mcp/issues"
  },
  "homepage": "https://github.com/corcronje/teamwork-mcp#readme",
  "keywords": [
    "mcp",
    "teamwork",
    "model-context-protocol",
    "agent-tools",
    "automation"
  ],
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.28.0",
    "zod": "^3.23.8"
  },
  "engines": {
    "node": ">=18"
  }
}
