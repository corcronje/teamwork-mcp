# Teamwork MCP server configuration.
# MCP clients usually pass these in their own config (see docs/CLIENT_SETUP.md).
# A local .env is gitignored and is read by the live test suite.

TEAMWORK_BASE_URL=https://your-site.teamwork.com
TEAMWORK_API_TOKEN=replace_with_real_token
# basic_token_x (default; Teamwork API keys) | bearer (OAuth access tokens only)
TEAMWORK_AUTH_MODE=basic_token_x
TEAMWORK_API_VERSION=v3

# true blocks every write tool
TEAMWORK_READ_ONLY=false

# Optional comma-separated project ids that write tools may touch (empty = any project)
TEAMWORK_ALLOWED_PROJECT_IDS=

# Optional comma-separated directories that upload tools may read files from (empty = any)
TEAMWORK_UPLOAD_ROOTS=

# Optional tuning
# TEAMWORK_REQUEST_TIMEOUT=30000
# TEAMWORK_MAX_RETRIES=3
# LOG_LEVEL=info

# Live test suite only (npm run test:live): a project where a temporary task may be created
# TEAMWORK_TEST_PROJECT_ID=
