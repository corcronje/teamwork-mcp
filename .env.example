TEAMWORK_BASE_URL=https://your-teamwork-site.com
TEAMWORK_API_VERSION=v3
TEAMWORK_API_TOKEN=replace_with_real_token
# bearer | basic_token_x — Teamwork API v3 uses basic_token_x (token:x basic auth)
TEAMWORK_AUTH_MODE=basic_token_x

# true blocks all create/update/comment/move tools
TEAMWORK_READ_ONLY=false

# Optional comma-separated project IDs to allow write operations
# Example: 12345,67890
TEAMWORK_ALLOWED_PROJECT_IDS=
